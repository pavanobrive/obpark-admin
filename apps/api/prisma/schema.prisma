generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  phone        String?
  role         Role      @default(CUSTOMER)
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  sessions     Session[]
  vehicles     Vehicle[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Vehicle {
  id                   String                @id @default(cuid())
  userId               String
  vrn                  String
  make                 String
  model                String
  year                 Int
  fuelType             FuelType              @default(PETROL)
  colour               String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  cartItems            CartItem[]
  rcLookup             RcLookup?
  rechargeTransactions RechargeTransaction[]
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vrn])
  @@index([vrn])
}

model RcLookup {
  id              String    @id @default(cuid())
  vehicleId       String    @unique
  vrn             String    @unique
  rawData         Json
  insuranceExpiry DateTime?
  puccExpiry      DateTime?
  fitnessExpiry   DateTime?
  challanCount    Int       @default(0)
  fastagActive    Boolean   @default(false)
  healthScore     Int       @default(0)
  fetchedAt       DateTime  @default(now())
  expiresAt       DateTime
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vrn])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String?
  categoryId    String
  basePrice     Decimal     @db.Decimal(10, 2)
  images        String[]
  compatibility Json
  isActive      Boolean     @default(true)
  stock         Int         @default(0)
  sku           String      @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  category      Category    @relation(fields: [categoryId], references: [id])
  variants      Variant[]
  reviews Review[]

  @@index([slug])
  @@index([categoryId])
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  sku       String   @unique
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  vehicleId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@unique([cartId, productId, vehicleId])
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  addressId  String
  status     OrderStatus @default(PENDING)
  subtotal   Decimal     @db.Decimal(10, 2)
  discount   Decimal     @default(0) @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  couponCode String?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  address    Address     @relation(fields: [addressId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id])

  @@index([razorpayOrderId])
}

model RechargeTransaction {
  id                String         @id @default(cuid())
  vehicleId         String
  vrn               String
  amount            Decimal        @db.Decimal(10, 2)
  razorpayOrderId   String         @unique
  razorpayPaymentId String?
  status            RechargeStatus @default(PENDING)
  idempotencyKey    String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id])

  @@index([vrn])
  @@index([vehicleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(FLAT)
  discountValue Decimal      @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  @@index([code])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  customerName String
  rating       Int
  comment      String
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  REJECTED
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  CNG
  HYBRID
}

enum RechargeStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  FLAT
  PERCENTAGE
}
